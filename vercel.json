{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/status?route=health" },
    { "source": "/api/config", "destination": "/api/status?route=config" },
    { "source": "/api/sync-status", "destination": "/api/status?route=sync-status" },
    { "source": "/api/meta-oauth-start", "destination": "/api/meta-oauth" },
    { "source": "/api/meta-oauth-callback", "destination": "/api/meta-oauth?route=callback" },
    { "source": "/api/google-oauth-start", "destination": "/api/google-accounts?route=start" },
    { "source": "/api/google-oauth-callback", "destination": "/api/google-accounts?route=callback" },
    { "source": "/api/tiktok-oauth-start", "destination": "/api/tiktok-accounts?route=start" },
    { "source": "/api/tiktok-oauth-callback", "destination": "/api/tiktok-accounts?route=callback" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
